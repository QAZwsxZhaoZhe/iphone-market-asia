# Compose project
APP_ENV=development
API_PORT=8000
WEB_PORT=3000
POSTGRES_DB=iphone_market
POSTGRES_USER=iphone_market
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Public API and internal authentication
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_MODE=api_key
PLATFORM_API_KEY=replace-with-a-long-random-internal-key
INTERNAL_ROLES=admin,operator,analyst
SESSION_TTL_HOURS=336
ALLOW_PUBLIC_REGISTRATION=true
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Platform Admin
BOOTSTRAP_ADMIN_PASSWORD=

# OIDC SSO. Switch AUTH_MODE to oidc and configure all three values in production.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles

# Collection scheduling and browser limits
COLLECTION_LIMIT=30
COLLECTION_MAX_RETRIES=3
COLLECTION_RETRY_BACKOFF_SECONDS=60
BROWSER_MAX_CONCURRENCY=2
COLLECTION_SCHEDULE_HOUR=8
COLLECTION_SCHEDULE_MINUTE=0
IPHONE_MARKET_PROXY_URL=

# PostgreSQL, Redis and OpenSearch
# DATABASE_URL is for direct local CLI use. Compose builds the in-network URL itself.
# DATABASE_URL=postgresql+psycopg://iphone_market:password@127.0.0.1:5432/iphone_market
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=hk-iphone-listings
OPENSEARCH_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# S3-compatible raw snapshot storage
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_BUCKET=iphone-market-raw
OBJECT_STORE_ENDPOINT_URL=http://127.0.0.1:9000
OBJECT_STORE_ACCESS_KEY=iphone_market
OBJECT_STORE_SECRET_KEY=replace-with-a-strong-object-store-secret
# Leave empty for local MinIO. Set to AES256 when using AWS S3 with default encryption.
OBJECT_STORE_SSE=
MINIO_ROOT_USER=iphone_market
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
AWS_DEFAULT_REGION=us-east-1

# Retention, search and valuation
RAW_CAPTURE_RETENTION_DAYS=30
LISTING_STALE_HOURS=36
DEFAULT_PAGE_SIZE=30
MAX_PAGE_SIZE=100
TARGET_MARGIN_PCT=12
OPPORTUNITY_FEE_PCT=12

# Payments. Development uses the built-in mock PSP.
# Production must use a real provider and a strong webhook signing secret.
PAYMENT_PROVIDER=mock
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
PAYMENT_RETURN_URL=http://127.0.0.1:3000/account/orders
PAYMENT_API_BASE_URL=https://api.stripe.com

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
